# Omrežna vezava mora ostati na loopback naslovu, dokler ni dodan varnostni sklop.
HAM_BIND_ADDRESS=127.0.0.1
HAM_HOST_PORT=8000

# Na Linuxu po potrebi uskladite z izpisoma `id -u` in `id -g`.
HAM_UID=1000
HAM_GID=1000

# Ustvarite z: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Vrednost hranite samo v lokalni .env datoteki.
HAM_SESSION_SECRET=
HAM_SECURE_COOKIES=false
HAM_SESSION_MAX_AGE_SECONDS=1800
HAM_ALLOWED_HOSTS=127.0.0.1,localhost
HAM_MAX_ATTACHMENT_BYTES=10485760

# Izbirno: omogoči AI-prepoznavo fotografij v mobilnem čarovniku.
GEMINI_API_KEY=
HAM_GEMINI_MODEL=gemini-3.7-flash
